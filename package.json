{
  "name": "@namewta/dsh-plugin-herdr",
  "version": "0.0.3",
  "description": "Observe and drive Herdr from DeepSeek Harness: herdr tools, a session preset, and a Web panel.",
  "license": "MIT",
  "author": "NAMEWTA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAMEWTA/dsh-plugin-herdr.git"
  },
  "bugs": {
    "url": "https://github.com/NAMEWTA/dsh-plugin-herdr/issues"
  },
  "homepage": "https://github.com/NAMEWTA/dsh-plugin-herdr#readme",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "assets/home.png",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-mode": {
      "types": "./lib/session-mode.d.ts",
      "default": "./lib/session-mode.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1 || 4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1 || 3.18.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/gen-typert.mjs && tsdown --config tsdown.web.config.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:types:check": "node scripts/gen-types.mjs --check",
    "gen:typert": "node scripts/gen-typert.mjs",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "node --experimental-transform-types --test \"test/unit/*.test.ts\"",
    "test:integration": "pnpm build && node test/integration/run.mjs && node test/integration/extended.mjs && node test/integration/events.mjs && node test/integration/close-rename.mjs && node test/integration/terminal-session.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm build && pnpm typecheck && pnpm gen:types:check && pnpm test:unit && pnpm test:package",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "node --test test/packaging/*.test.mjs"
  }
}
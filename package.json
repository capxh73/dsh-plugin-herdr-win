{
  "name": "@namewta/dsh-plugin-herdr",
  "version": "0.0.3",
  "description": "Observe and drive Herdr from DeepSeek Harness: herdr tools, a session preset, and a Web panel.",
  "license": "MIT",
  "author": "NAMEWTA",
  "contributors": [
    "sunny0826",
    "capxh73 (native Windows adaptation)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capxh73/dsh-plugin-herdr-win.git"
  },
  "bugs": {
    "url": "https://github.com/capxh73/dsh-plugin-herdr-win/issues"
  },
  "homepage": "https://github.com/capxh73/dsh-plugin-herdr-win#readme",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "assets/home.png",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-mode": {
      "types": "./lib/session-mode.d.ts",
      "default": "./lib/session-mode.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1 || 4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1 || 3.18.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/session-mode.js && node --check lib/typert.host.js && node --check lib/environment-contract.js && node --check lib/binding-registry-CamHbZhK.js"
  }
}